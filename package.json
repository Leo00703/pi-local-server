{
  "name": "pi-local-server",
  "version": "0.1.1",
  "description": "Pi extension that auto-discovers local LLM servers on your LAN first, then Tailscale, and registers each as its own Pi provider with dynamic models + context windows.",
  "type": "module",
  "license": "MIT",
  "author": "Leonardo Galli",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Leo00703/pi-local-server.git"
  },
  "homepage": "https://github.com/Leo00703/pi-local-server#readme",
  "keywords": [
    "pi-package",
    "pi",
    "pi-extension",
    "llm",
    "local-llm",
    "llama.cpp",
    "lm-studio",
    "ollama",
    "vllm",
    "sglang",
    "tailscale",
    "lan"
  ],
  "pi": {
    "extensions": [
      "./extensions/pi-local-server/index.ts"
    ]
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "devDependencies": {
    "typescript": "^5.6.0",
    "@types/node": "^22.0.0"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "tsc --noEmit"
  },
  "engines": {
    "node": ">=22.19.0"
  }
}
